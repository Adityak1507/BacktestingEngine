# Copy to .env (git-ignored) and fill in the keys you have; chains skip providers without a key.
# Groq:        https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter:  https://openrouter.ai/keys   (free models: ~50 requests/day without credits)
OPENROUTER_API_KEY=
# NVIDIA NIM:  https://build.nvidia.com     (API key from any model page)
NVIDIA_API_KEY=
# Hugging Face: https://huggingface.co/settings/tokens  (token with "Inference Providers" permission)
HF_TOKEN=
# GitHub Models: a GitHub personal access token with the models:read permission
GITHUB_TOKEN=
# Mistral:     https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Google AI Studio (Gemma): https://aistudio.google.com/apikey
GEMINI_API_KEY=
